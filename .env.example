# Copy to .env and fill in. .env is gitignored - never commit real values.

# Cookies exported from a logged-in TikTok session.
# Shape: {"cookies": [{"name": ..., "value": ..., "domain": ...}, ...]}
TIKTOK_COOKIES_PATH=secrets/tiktok_cookies.json

# Where crawled videos and metadata are written. Defaults to ./data
VIDCORPUS_DATA_DIR=data
